# Settings for the Hustlempires server. Copy to /etc/hustle.env and edit.

# Password for the admin dashboard at /admin. Use at least 10 characters.
# The admin dashboard stays switched off until this is set.
HUSTLE_ADMIN_PASSWORD=change-this-to-a-long-password

# Port the game listens on (only nginx talks to it, from the same server).
HUSTLE_PORT=8090

# Keep this at 1 once the site runs on https://. Log-ins only work over HTTPS when it is 1.
HUSTLE_SECURE_COOKIES=1

# Your game's domain (no https://). Used in password-reset links.
HUSTLE_SITE_DOMAIN=shwariapps.com

# Old web addresses of the game (comma separated). Their pages forward to HUSTLE_SITE_DOMAIN.
HUSTLE_OLD_DOMAINS=

# Password reset emails. Leave HUSTLE_MAIL_PROVIDER empty to keep them off.
# resend or brevo: set HUSTLE_MAIL_KEY to the API key from that service.
# Emails come from no-reply@<HUSTLE_SITE_DOMAIN> unless you set HUSTLE_MAIL_FROM.
HUSTLE_MAIL_PROVIDER=
HUSTLE_MAIL_KEY=

# Hustle Pass (free trial, then pay through Pesapal). Leave HUSTLE_BILLING empty or 0 to let everyone play free.
# When it is 1: 24-hour free trial, then players who leave the payment screen are offered 2 more free days
# (twice), and after 7 days there is no more free play. Players who joined before it was switched on
# get their 24 hours from the moment it is switched on.
HUSTLE_BILLING=
# From your Pesapal merchant dashboard (API keys / consumer key and secret).
HUSTLE_PESAPAL_KEY=
HUSTLE_PESAPAL_SECRET=
# live, or sandbox for Pesapal's test system (sandbox needs sandbox keys).
HUSTLE_PESAPAL_ENV=live
# Optional: prices in Kenya shillings and trial settings.
# HUSTLE_PRICE_WEEK=70
# HUSTLE_PRICE_MONTH=250
# HUSTLE_PRICE_YEAR=2000
# HUSTLE_TRIAL_HOURS=24
# HUSTLE_GIFT_DAYS=2
# HUSTLE_GIFTS=2
# HUSTLE_BLOCK_DAYS=7
