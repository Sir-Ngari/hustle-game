# Settings for the Hustle to a Billion server. Copy to /etc/hustle.env and edit.

# Password for the admin dashboard at /admin. Use at least 10 characters.
# The admin dashboard stays switched off until this is set.
HUSTLE_ADMIN_PASSWORD=change-this-to-a-long-password

# Port the game listens on (only nginx talks to it, from the same server).
HUSTLE_PORT=8090

# Keep this at 1 once the site runs on https://. Log-ins only work over HTTPS when it is 1.
HUSTLE_SECURE_COOKIES=1
