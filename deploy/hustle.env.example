# Settings for the Hustle to an Empire server. Copy to /etc/hustle.env and edit.

# Password for the admin dashboard at /admin. Use at least 10 characters.
# The admin dashboard stays switched off until this is set.
HUSTLE_ADMIN_PASSWORD=change-this-to-a-long-password

# Port the game listens on (only nginx talks to it, from the same server).
HUSTLE_PORT=8090

# Keep this at 1 once the site runs on https://. Log-ins only work over HTTPS when it is 1.
HUSTLE_SECURE_COOKIES=1

# Your game's domain (no https://). Used in password-reset links.
HUSTLE_SITE_DOMAIN=shwariapps.com

# Password reset emails. Leave HUSTLE_MAIL_PROVIDER empty to keep them off.
# resend or brevo: set HUSTLE_MAIL_KEY to the API key from that service.
# Emails come from no-reply@<HUSTLE_SITE_DOMAIN> unless you set HUSTLE_MAIL_FROM.
HUSTLE_MAIL_PROVIDER=
HUSTLE_MAIL_KEY=
